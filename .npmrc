# Node is pinned to 25.4.0 in .node-version, in the Dockerfile (ARG NODE_VERSION),
# and in CI (actions/setup-node with node-version-file). package.json engines.node
# mirrors that pin, so npm prints an EBADENGINE warning on a mismatched local Node
# and still installs.
#
# engine-strict stays off deliberately. It turns that warning into a hard install
# failure, and the check runs over every package in the tree, not just this one
# (arborist build-ideal-tree.js iterates idealTree.inventory). Dependencies that
# enumerate LTS majors without an open upper bound would then block installs on an
# odd-numbered line like 25 over third-party metadata alone. The current tree does
# pass with engine-strict on, so this is about future dependency churn, not a
# present-day failure. Enforcement lives in the Dockerfile and CI pins; the warning
# is the signal wanted here.
engine-strict=false
