# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore Python TTS environment. Docker does not read .gitignore, so these
# have to be repeated here. .uv-cache is ~9G and .venv hardlinks into it,
# which is what made the production image 10.8G.
/.uv-cache
/.venv
/uv.lock

# Ignore test and coverage artifacts.
/test
/e2e
/test-results
/coverage
/playwright-report
/.playwright-mcp

# Ignore documentation.
/docs

# Ignore editor and local tooling state.
/tags
/.lsp.json
/.mcp.json
/.claude
/.beads

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
