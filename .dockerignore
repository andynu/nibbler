# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# On-disk caches. Every file in these is named after a local primary key, so a
# dev cache is meaningless (and can be actively wrong) against the production
# database, and the audio wavs are large. Each path is a Kamal volume in
# production and is recreated on demand via mkdir_p elsewhere.
/public/icons
/public/images/cache
/public/audio/cache

# Ignore Python TTS environment. Docker does not read .gitignore, so these
# have to be repeated here. .uv-cache is ~9G and .venv hardlinks into it,
# which is what made the production image 10.8G.
/.uv-cache
/.venv
/uv.lock

# Piper voice models, 61M of .onnx. The image has no Python interpreter, so
# TtsGenerator reports itself unavailable there and never reads these.
# lib/tts/generate.py stays for reference; it costs 7K.
/lib/tts/models
**/__pycache__

# Ignore test and coverage artifacts.
/test
/e2e
/test-results
/coverage
/playwright-report
/.playwright-mcp

# Ignore documentation.
/docs

# Ignore editor and local tooling state.
/tags
/.lsp.json
/.mcp.json
/.claude
/.beads

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
