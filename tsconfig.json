{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./app/javascript/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  // playwright.config.ts and vitest.config.mts run in Node and are checked by
  // tsconfig.node.json. Adding "node" to types here would put Node's globals in
  // front of the browser ones for app/javascript too.
  "include": ["app/javascript/**/*", "test/**/*", "e2e/**/*"]
}
